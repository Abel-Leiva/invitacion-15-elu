---

---

<section
  id="apertura"
  class="fixed inset-0 z-50 flex min-h-screen w-full flex-col items-center justify-start overflow-y-auto bg-[#fce7e9]"
>
  <!-- Techo floral -->
  <img
    src="images/techo-flor.png"
    alt=""
    class="absolute top-0 left-0 z-10 w-full drop-shadow-[0_4px_6px_rgba(0,0,0,0.4)]"
  />

  <!-- CONTENIDO -->
  <div
    class="relative z-20 flex w-full flex-col items-center px-5 pt-24.75 sm:pt-55 md:pt-75"
  >
    <!-- Mis XV años + sobre -->
    <div class="w-full max-w-2xl text-center">
      <p class="mt-1 mb-4 font-great-vibes text-3xl font-medium text-[#B87824]">
        Mis
        <span
          class="font-lora text-4xl font-light tracking-normal text-[#C98B2E]"
          >{" "}
          XV{" "}
        </span>
        años
      </p>

      <h1 class="font-great-vibes text-5xl text-[#B87824]">Eluney Sofía</h1>
      <!-- Separador -->
      <div class="mx-auto my-4 flex items-center justify-center gap-3">
        <div class="h-px w-16 bg-[#C98B2E]/50"></div>

        <span class="text-xl text-[#C98B2E]">✦</span>

        <div class="h-px w-16 bg-[#C98B2E]/50"></div>
      </div>
      <!-- Frase -->
      <p
        class="mt-4 max-w-lg px-3 font-lora text-lg font-medium italic leading-relaxed text-[#8F683F]"
      >
        "Hay momentos en la vida que merecen celebrarse de una manera
        especial... y me encantaría compartir este con todos ustedes."
      </p>

      <!-- Sobre -->
      <button
        id="boton-apertura"
        type="button"
        aria-label="Abrir invitación"
        class="group mt-0 cursor-pointer"
      >
        <img
          src="images/sobre-dorado-E.S-2.png"
          alt="Tocar para abrir la invitación"
          width="200"
          height="220"
          class="drop-shadow-[0_4px_6px_rgba(0,0,0,0.4)] transition-transform duration-300 group-hover:scale-105 group-active:scale-95"
        />
      </button>

      <!-- Indicador -->
      <p class="mt-0 font-lora text-xl italic text-[#C98B2E]">
        Tocá el sobre para abrir la invitación.
      </p>
    </div>

    <!-- Invitado -->
    <!-- <div class="mt-1 text-center">
      <p
        id="nombre-invitado-apertura"
        class="mt-2 font-great-vibes text-4xl text-[#B87824]"
      >
        Invitado
      </p>

      <p
        id="acompanantes-apertura"
        class="mt-1.5 hidden font-lora text-xl text-[#B87824]/80"
      >
      </p>
    </div> -->
  </div>

  <!-- JavaScript -->
  <script>
    import { invitados } from "../data/invitados.js";
    import lanzarConfetti from "canvas-confetti";

    // --------------------------------
    // BUSCAR INVITADO POR ID
    // --------------------------------

    const parametros = new URLSearchParams(window.location.search);

    const idInvitado = Number(parametros.get("invitado"));

    const invitadoSeleccionado = invitados.find(
      (invitado) => invitado.id === idInvitado,
    );

    const nombreInvitado = document.getElementById("nombre-invitado-apertura");

    const acompanantesElemento = document.getElementById(
      "acompanantes-apertura",
    );

    if (invitadoSeleccionado) {
      // Mostrar nombre
      if (nombreInvitado) {
        nombreInvitado.textContent = invitadoSeleccionado.nombre;
      }

      // Mostrar acompañantes solamente para individuales
      if (
        acompanantesElemento &&
        invitadoSeleccionado.tipo === "individual" &&
        invitadoSeleccionado.acompanantesPermitidos > 0
      ) {
        const cantidad = invitadoSeleccionado.acompanantesPermitidos;

        acompanantesElemento.textContent = `+ ${cantidad} ${
          cantidad === 1 ? "acompañante" : "acompañantes"
        }`;

        acompanantesElemento.classList.remove("hidden");
      }
    }

    // --------------------------------
    // APERTURA + CONFETI + SONIDO
    // --------------------------------

    const apertura = document.getElementById("apertura");
    const boton = document.getElementById("boton-apertura");
    const contenido = document.getElementById("contenido-invitacion");

    let audioContext: AudioContext;
    let audioBuffer: AudioBuffer;

    async function cargarSonido() {
      try {
        audioContext = new AudioContext();

        const respuesta = await fetch("/music/confetti-recortado.mp3");

        const datos = await respuesta.arrayBuffer();

        audioBuffer = await audioContext.decodeAudioData(datos);
      } catch (error) {
        console.error("No se pudo cargar el sonido del confeti:", error);
      }
    }

    cargarSonido();

    function reproducirSonido() {
      if (!audioContext || !audioBuffer) return;

      const fuente = audioContext.createBufferSource();
      const volumen = audioContext.createGain();

      fuente.buffer = audioBuffer;
      volumen.gain.value = 0.7;

      fuente.connect(volumen);
      volumen.connect(audioContext.destination);

      fuente.start(0);
    }

    boton?.addEventListener("click", async () => {
      if (audioContext?.state === "suspended") {
        await audioContext.resume();
      }

      contenido?.classList.remove("hidden");

      apertura?.classList.add(
        "opacity-0",
        "pointer-events-none",
        "transition-opacity",
        "duration-1000",
      );

      setTimeout(() => {
        // 🔊 PAF
        reproducirSonido();

        // 🎉 Confeti
        setTimeout(() => {
          const confetti = lanzarConfetti({
            particleCount: 150,
            spread: 90,
            startVelocity: 40,
            gravity: 0.6,
            scalar: 0.9,

            origin: {
              x: 0.5,
              y: 0.65,
            },

            colors: [
              "#CC5F16",
              "#FFD166",
              "#CC5f44",
              "#FF8FAB",

              "#ffd187",

              "#FF9F1C",
            ],
          });

          // 🎵 Música 500 ms después de terminar el confeti
          confetti?.then(() => {
            setTimeout(() => {
              window.dispatchEvent(new Event("musica-iniciar"));
            }, 500);
          });
        }, 200);
      }, 900);

      setTimeout(() => {
        apertura?.remove();
      }, 1000);
    });
  </script>
</section>
