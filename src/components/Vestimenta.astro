<section class="relative w-full bg-[#E7FCFA] px-6 pb-24 pt-16">
  <div class="relative z-10 mx-auto w-full max-w-2xl text-center">
    <!-- Vestimenta -->
    <div class="mx-auto max-w-lg">
      <!-- Título + iconos -->
      <div class="flex items-center justify-center gap-2">
        <h3 class="font-great-vibes text-4xl text-[#B87824]">Vestimenta</h3>

        <div class="flex items-center gap-1">
          <img src="/icon/vestido.svg" alt="" class="mb-1 h-6 w-6" />

          <img src="/icon/smokin.svg" alt="" class="mb-0.5 h-6 w-6" />
        </div>
      </div>

      <!-- Separador -->
      <div class="mx-auto my-7 flex items-center justify-center gap-3">
        <div class="h-px w-14 bg-[#C98B2E]/40"></div>

        <span class="text-lg text-[#C98B2E]">✦</span>

        <div class="h-px w-14 bg-[#C98B2E]/40"></div>
      </div>

      <p
        class="mt-4 font-lora text-xl font-medium italic leading-relaxed text-[#8F683F]"
      >
        Elijan el estilo con el que se sientan más cómodos para compartir y
        disfrutar de esta celebración.
      </p>

      <p
        class="mt-4 font-lora text-xl font-medium italic leading-relaxed text-[#8F683F]"
      >
        Solo les pido que, por favor, eviten usar el color{" "}
        <span class="font-lora font-semibold text-[#C98B2E]">dorado</span>, que
        es el que reservé para mí.
      </p>
    </div>

    <!-- Separador -->
    <div class="mx-auto my-10 h-px w-20 bg-[#C98B2E]/30"></div>

    <!-- Regalos -->
    <div class="mx-auto max-w-lg">
      <div class="flex items-center justify-center gap-2">
        <h3 class="font-great-vibes text-4xl text-[#B87824]">Regalos</h3>
        <img src="/icon/regalo.svg" alt="" class="mb-1.5 h-6 w-6" />
      </div>

      <!-- Separador -->
      <div class="mx-auto my-7 flex items-center justify-center gap-3">
        <div class="h-px w-14 bg-[#C98B2E]/40"></div>

        <span class="text-lg text-[#C98B2E]">✦</span>

        <div class="h-px w-14 bg-[#C98B2E]/40"></div>
      </div>

      <p
        class="mt-4 font-lora text-xl font-medium italic leading-relaxed text-[#8F683F]"
      >
        Su presencia será el mejor regalo. Pero si además desean hacerme un
        obsequio, pueden hacerlo en un sobre la noche del evento o mediante
        transferencia al alias{" "}
        <span class="font-lora font-semibold text-[#C98B2E]">elu15.regalos</span
        >, cuenta a nombre de mi mamá,
        <span class="font-lora font-semibold">
          Olga Mariela Cardozo Jaime
        </span>.
      </p>
    </div>

    <!-- Separador -->
    <div class="mx-auto my-10 h-px w-20 bg-[#C98B2E]/30"></div>

    <!-- Confirmación -->
    <div class="mx-auto max-w-lg">
      <div class="flex items-center justify-center gap-2">
        <h3 class="font-great-vibes text-4xl text-[#B87824]">
          Confirmación de asistencia
        </h3>
        <img src="/icon/check.svg" alt="" class="mb-1 h-6 w-6" />
      </div>

      <!-- Separador -->
      <div class="mx-auto my-7 flex items-center justify-center gap-3">
        <div class="h-px w-14 bg-[#C98B2E]/40"></div>

        <span class="text-lg text-[#C98B2E]">✦</span>

        <div class="h-px w-14 bg-[#C98B2E]/40"></div>
      </div>

      <p
        class="mt-4 font-lora text-xl font-medium italic leading-relaxed text-[#8F683F]"
      >
        Más cerca de la fecha van a encontrar aquí la opción para confirmar su
        asistencia.
      </p>

      <p
        class="mt-3 font-lora text-base font-medium italic leading-relaxed text-[#8F683F]/80"
      >
        Así podremos preparar todo para recibirlos como merecen.
      </p>
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 z-20 h-[80px] md:h-[130px] w-full translate-y-1/2 overflow-hidden pointer-events-none flex flex-col"
  >
    <!-- Mitad superior: Color arena -->
    <div class="h-1/2 w-full bg-[#e7fcfa]"></div>
    <!-- Mitad inferior: Color turquesa -->
    <div class="h-1/2 w-full bg-[#efe7fc]"></div>

    <!-- Imagen montada encima con fusión multiplicar -->
    <img
      src="/images/separador-ultimo.png"
      alt="Separador floral"
      class="absolute left-1/2 top-1/2 w-85 -translate-x-1/2 -translate-y-1/2 object-contain object-center mix-blend-multiply drop-shadow-[0_4px_6px_rgba(0,0,0,0.4)] md:w-[75%] lg:w-[65%] xl:w-[60%]"
    />
  </div>
</section>
