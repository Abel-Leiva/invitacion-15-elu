---
import CuentaRegresiva from "./CuentaRegresiva.astro";
import InformacionEvento from "./InformacionEvento.astro";
import Musica from "./Musica.astro";
import Ubicacion from "./Ubicacion.astro";
import Vestimenta from "./Vestimenta.astro";
---

<main
  id="contenido-invitacion"
  class="relative min-h-screen w-full overflow-hidden bg-[#fce7e9] text-[#F5EAD0]"
>
  <Musica />

  <div
    id="cartel-confirmar"
    class="fixed inset-x-0 top-0 z-40 hidden border-b border-[#C98B2E]/30 bg-[#E7FCFA] shadow-[0_4px_16px_rgba(143,104,63,0.18)] transition-opacity duration-500"
  >
    <button
      id="boton-confirmar"
      type="button"
      aria-label="Ya podés confirmar tu asistencia"
      class="flex w-full flex-col items-center px-14 py-3 text-center"
    >
      <span class="font-great-vibes text-[27px] leading-tight text-[#B87824]">
        Ya podés confirmar tu asistencia
      </span>
      <span
        class="mt-0.5 block font-lora text-[13px] italic leading-snug text-[#8F683F]/75"
      >
        <strong class="font-semibold not-italic text-[#8F683F]">Tocá acá</strong>{" "}
        o buscá más abajo la sección de confirmación{" "}
        <svg
          class="flecha-abajo ml-1 inline-block h-6 w-6 text-[#B87824]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
      </span>
    </button>

    <button
      id="cerrar-cartel"
      type="button"
      aria-label="Cerrar aviso"
      class="absolute right-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full text-lg text-[#8F683F]/70 transition hover:bg-[#C98B2E]/15"
    >
      ✕
    </button>
  </div>

  <InformacionEvento />

  <Ubicacion />
  <Vestimenta />
  <CuentaRegresiva />
</main>

<style>
  .flecha-abajo {
    animation: flecha-bajar 1.5s ease-in-out infinite;
  }

  @keyframes flecha-bajar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flecha-abajo {
      animation: none;
    }
  }
</style>
