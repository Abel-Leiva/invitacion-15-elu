---
import CuentaRegresiva from "./CuentaRegresiva.astro";
import InformacionEvento from "./InformacionEvento.astro";
import Musica from "./Musica.astro";
import Ubicacion from "./Ubicacion.astro";
import Vestimenta from "./Vestimenta.astro";
---

<main
  id="contenido-invitacion"
  class="relative min-h-screen w-full overflow-hidden bg-[#fce7e9] text-[#F5EAD0]"
>
  <Musica />

  <div
    id="cartel-confirmar"
    class="fixed inset-x-0 top-0 z-40 hidden border-b border-[#C98B2E]/30 bg-[#E7FCFA] shadow-[0_4px_16px_rgba(143,104,63,0.18)] transition-opacity duration-500"
  >
    <button
      id="boton-confirmar"
      type="button"
      aria-label="Ya podés confirmar tu asistencia"
      class="flex w-full flex-col items-center px-14 py-3 text-center"
    >
      <span class="font-great-vibes text-[25px] leading-tight text-[#B87824]">
        Ya podés confirmar tu asistencia
      </span>
      <span
        class="mt-0.5 block font-lora text-[11px] italic leading-snug text-[#8F683F]/75"
      >
        Tocá acá o buscá más abajo la sección de confirmación
      </span>
    </button>

    <button
      id="cerrar-cartel"
      type="button"
      aria-label="Cerrar aviso"
      class="absolute right-2 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full text-lg text-[#8F683F]/70 transition hover:bg-[#C98B2E]/15"
    >
      ✕
    </button>
  </div>

  <InformacionEvento />

  <Ubicacion />
  <Vestimenta />
  <CuentaRegresiva />
</main>
