<audio id="musica-fondo" preload="auto">
  <source src="/music/cancion.mp3" type="audio/mpeg" />
</audio>

<button
  id="boton-musica"
  type="button"
  aria-label="Reproducir música"
  class="fixed bottom-6 right-6 z-40 flex h-14 w-14 items-center justify-center rounded-full border-2 border-[#D4AF37] bg-[#101827]/90 text-2xl text-[#E5C76B] shadow-lg transition hover:scale-110"
>
  ♫
</button>

<script>
  const musica = document.getElementById(
    "musica-fondo",
  ) as HTMLAudioElement | null;

  const boton = document.getElementById("boton-musica");

  const VOLUMEN = 0.7;

  if (musica) {
    musica.volume = VOLUMEN;
  }

  function subirVolumen(duracion = 1200) {
    if (!musica) return;

    const inicio = performance.now();

    const paso = (ahora: number) => {
      if (!musica) return;
      const avance = Math.min(1, (ahora - inicio) / duracion);
      musica.volume = VOLUMEN * avance;
      if (avance < 1) requestAnimationFrame(paso);
    };

    requestAnimationFrame(paso);
  }

  // La música comienza únicamente cuando Apertura lo indique
  window.addEventListener("musica-iniciar", async () => {
    if (!musica) return;

    try {
      musica.volume = 0;
      await musica.play();
      subirVolumen();

      if (boton) {
        boton.textContent = "❚❚";
        boton.setAttribute("aria-label", "Pausar música");
      }
    } catch (error) {
      musica.volume = VOLUMEN;
      console.error("No se pudo reproducir la música:", error);
    }
  });

  boton?.addEventListener("click", async () => {
    if (!musica) return;

    if (musica.paused) {
      if (musica.volume < 0.05) musica.volume = VOLUMEN;
      await musica.play();

      boton.textContent = "❚❚";
      boton.setAttribute("aria-label", "Pausar música");
    } else {
      musica.pause();

      boton.textContent = "♫";
      boton.setAttribute("aria-label", "Reproducir música");
    }
  });
</script>
