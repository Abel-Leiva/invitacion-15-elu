---

---

<section
  class="relative flex w-full flex-col items-center bg-[#FCE7E9] px-4 pb-24 pt-16"
>
  <!-- Techo floral -->
  <img
    src="images/techo-flor.png"
    alt=""
    class="pointer-events-none absolute top-0 left-0 z-20 w-full drop-shadow-[0_4px_6px_rgba(0,0,0,0.4)]"
  />

  <!-- CONTENIDO -->

  <div
    class="relative z-20 flex w-full flex-col items-center px-5 pt-13.75 sm:pt-55 md:pt-75"
  >
    <!-- Invitado -->
    <div class="text-center">
      <h2
        id="nombre-invitado"
        class="mt-2 font-great-vibes text-5xl text-[#B87824] md:text-6xl"
      >
        Invitado
      </h2>
    </div>

    <!-- Separador -->
    <div class="mx-auto my-7 flex items-center justify-center gap-3">
      <div class="h-px w-14 bg-[#C98B2E]/40"></div>

      <span class="text-lg text-[#C98B2E]">✦</span>

      <div class="h-px w-14 bg-[#C98B2E]/40"></div>
    </div>

    <!-- Invitación -->
    <div class="mx-auto max-w-lg text-center">
      <p
        class="font-lora text-xl font-medium italic leading-relaxed text-[#8F683F]"
      >
        Junto a mi familia, el{" "}
        <span class="font-lora font-medium text-[#C98B2E]">
          5 de diciembre de 2026
        </span>{" "}
        voy a celebrar mis{" "}
        <span class="font-lora font-medium text-[#C98B2E]">XV</span>{" "}
        años, y me encantaría que puedan acompañarme.
      </p>

      <p
        class="mt-5 font-lora text-xl font-medium italic leading-relaxed text-[#8F683F]"
      >
        Los esperamos{" "}
        <span class="font-lora font-semibold text-[#8F683F]">
          a partir de las 20:30 hs
        </span>{" "}
        para compartir, disfrutar y pasarla lindo juntos.
      </p>

      <p
        class="mt-5 font-lora text-xl font-medium italic leading-relaxed text-[#8F683F]"
      >
        Les pedimos que sean puntuales, ya que{" "}
        <span class="font-lora font-medium text-[#C98B2E]">
          a las 21:30 hs haré mi entrada
        </span>
        , y nos gustaría mucho que estén ahí para recibirme.
      </p>
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 z-20 h-[90px] w-full translate-y-1/2 overflow-hidden pointer-events-none flex flex-col md:h-[110px]"
  >
    <div class="h-1/2 w-full bg-[#FCE7E9]"></div>
    <div class="h-1/2 w-full bg-[#FCFAE7]"></div>

    <img
      src="/images/separador-floral.png"
      alt="Separador"
      class="absolute left-1/2 top-1/2 w-85 -translate-x-1/2 -translate-y-1/2 object-contain object-center mix-blend-multiply drop-shadow-[0_4px_6px_rgba(0,0,0,0.4)] md:w-[75%] lg:w-[65%] xl:w-[60%]"
    />
  </div>
</section>

<script>
  import { invitados } from "../data/invitados.js";

  const nombreInvitado = document.getElementById("nombre-invitado");

  const parametros = new URLSearchParams(window.location.search);
  const idInvitado = Number(parametros.get("invitado"));

  // Buscar el invitado por su ID
  const invitadoSeleccionado = invitados.find(
    (invitado) => invitado.id === idInvitado,
  );

  if (nombreInvitado && invitadoSeleccionado) {
    let texto = invitadoSeleccionado.nombre;

    // Solo agregamos "invitado/s" en los casos individuales
    // que tienen invitados adicionales.
    if (invitadoSeleccionado.tipo === "individual") {
      const cantidadInvitados = invitadoSeleccionado.integrantes.filter(
        (integrante) => integrante.nombre === "Invitado",
      ).length;

      if (cantidadInvitados === 1) {
        texto += " y un acompañante";
      } else if (cantidadInvitados > 1) {
        texto += " y más acompañantes";
      }
    }

    nombreInvitado.textContent = texto;
  }
</script>
