<section
  class="relative flex w-full flex-col items-center bg-[#FCFAE7] px-6 pb-20 pt-16"
>
  <!-- Contenido -->
  <div class="relative z-10 mx-auto w-full max-w-2xl text-center">
    <h2 class="mt-3 font-great-vibes text-5xl text-[#B87824] md:text-6xl">
      Lugar de Recepción
    </h2>

    <!-- Separador -->
    <div class="mx-auto my-8 flex items-center justify-center gap-3">
      <div class="h-px w-14 bg-[#C98B2E]/40"></div>
      <span class="text-lg text-[#C98B2E]">✦</span>
      <div class="h-px w-14 bg-[#C98B2E]/40"></div>
    </div>

    <!-- Información del lugar -->
    <div class="mx-auto max-w-lg">
      <h3 class="font-great-vibes text-4xl text-[#B87824] md:text-5xl">
        Salón Cochabamba
      </h3>

      <p class="mt-5 font-lora italic text-xl font-medium text-[#8F683F]">
        Del Tejar 6113
      </p>

      <p
        class="mt-2 font-lora italic text-base font-medium leading-relaxed text-[#8F683F]/80"
      >
        Gregorio de Laferrere<br />
        Provincia de Buenos Aires
      </p>

      <!-- Botón -->
      <a
        href="https://www.google.com/maps/search/?api=1&query=Del+Tejar+6099-6197+Gregorio+de+Laferrere+Buenos+Aires"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-sm border border-[#C98B2E] px-7 py-3 font-lora italic text-sm font-medium uppercase tracking-[0.2em] text-[#B87824] transition duration-300 hover:bg-[#C98B2E] hover:text-white"
      >
        <span>Ver ubicación</span>
        <img src="/icon/ubicacion.svg" alt="" class="mb-1 h-5 w-5" />
      </a>
    </div>
  </div>

  <!-- 2. SOLUCIÓN: Separador floral incrustado exactamente en el borde inferior -->
  <div
    class="absolute bottom-0 left-0 z-20 h-[90px] md:h-[110px] w-full translate-y-1/2 overflow-hidden pointer-events-none flex flex-col"
  >
    <!-- Mitad superior: Color arena -->
    <div class="h-1/2 w-full bg-[#FCFAE7]"></div>
    <!-- Mitad inferior: Color turquesa -->
    <div class="h-1/2 w-full bg-[#E7FCFA]"></div>

    <!-- Imagen montada encima con fusión multiplicar -->
    <img
      src="/images/imagen-cambiar-color.png"
      alt="Separador floral"
      class="absolute left-1/2 top-1/2 w-85 -translate-x-1/2 -translate-y-1/2 object-contain object-center mix-blend-multiply drop-shadow-[0_4px_6px_rgba(0,0,0,0.4)] md:w-[75%] lg:w-[65%] xl:w-[60%]"
    />
  </div>
</section>

